  <library_effects>
    <effect id="Evergreen-effect">
      <profile_COMMON>
        <newparam sid="Evergreen_png-surface">
          <surface type="2D">
            <init_from>Evergreen_png</init_from>
          </surface>
        </newparam>
        <newparam sid="Evergreen_png-sampler">
          <sampler2D>
            <source>Evergreen_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="Evergreen_png-sampler" texcoord="Trees-UV0"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
